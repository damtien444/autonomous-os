HAL_MODE=production
HAL_LOG_LEVEL=INFO
DEVICE_TYPE=booster-k1
DEVICES_DIR=/opt/devices
# Board is detected from /proc/device-tree/model ('Booster K1 AGX Orin V1.0').
HAL_SIMULATE=0

# --- Booster SDK (head + camera drivers) ---
# DDS domain and the interface the SDK binds. On the K1, 127.0.0.1 is in
# Booster's DDS whitelist. Interfaces (recon 2026-11-25): enP1p1s0
# 192.168.10.102 (dev Ethernet), nv_eth0 192.168.13.101, usb_eth0
# 192.168.127.101 (internal). On-robot value UNVERIFIED; a dev machine on the
# cable uses its own NIC name instead (robots/booster-k1/docs/runtime.md).
BOOSTER_DDS_DOMAIN=0
BOOSTER_NET_IFACE=127.0.0.1
# RotateHead(pitch=+) looks down and (yaw=+) left; HAL +pitch is up, +yaw right.
# Defaults verified on a K1 (2026-11-25); flip only if a different unit disagrees.
#HAL_BOOSTER_PITCH_SIGN=-1
#HAL_BOOSTER_YAW_SIGN=-1

# --- Audio (recon 2026-11-25, K1 AGX Orin V1.0) ---
# Capture:  card 1 XFMDPV0018 [XFM-DP-V0.0.18], a USB voice/mic-array module.
# Playback: card 0 Device [USB Audio Device]. Cards 2 (HDMI) and 3 (Tegra APE) are unused.
# Addressed by card NAME so a USB re-enumeration cannot shift the index.
# The mic is read through Booster's audio service (no device ownership);
# HAL_AUDIO_INPUT_ALSA below is ignored while this is set.
HAL_AUDIO_INPUT_BACKEND=booster
HAL_AUDIO_INPUT_ALSA=plug:hw:CARD=XFMDPV0018,DEV=0
HAL_AUDIO_OUTPUT_ALSA=plug:hw:CARD=Device,DEV=0
HAL_AUDIO_SENSING_DEVICE=plug:hw:CARD=XFMDPV0018,DEV=0

# --- Camera ---
# No V4L2 device: ROBOT.md `driver: booster` reads Booster's JPEG stream
# (rt/booster_video_stream, 544x306 ~10 Hz). Index/size below are unused by it.
#BOOSTER_VIDEO_TOPIC=rt/booster_video_stream
HAL_CAMERA_INDEX=0
HAL_CAMERA_WIDTH=544
HAL_CAMERA_HEIGHT=306

OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
