# HAL on a dev machine driving a Booster K1 over the Ethernet cable.
# Sourced by robots/booster-k1/tools/run_hal_dev.sh. Change BOOSTER_NET_IFACE
# to the name of the NIC plugged into the robot (ip -br addr).
HAL_MODE=developer
HAL_LOG_LEVEL=INFO
DEVICE_TYPE=booster-k1
HAL_BOARD=booster_k1
HAL_SIMULATE=0
BOOSTER_DDS_DOMAIN=0
BOOSTER_NET_IFACE=enx00e04cfbda07
HAL_AUDIO_INPUT_BACKEND=booster
HAL_CAMERA_INDEX=0
HAL_CAMERA_WIDTH=544
HAL_CAMERA_HEIGHT=306
