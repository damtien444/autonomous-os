# HAL on a dev machine driving a Booster K1 over the Ethernet cable.
# Sourced by robots/booster-k1/tools/run_hal_dev.sh. Change BOOSTER_NET_IFACE
# to the name of the NIC plugged into the robot (ip -br addr).
HAL_MODE=developer
HAL_LOG_LEVEL=INFO
DEVICE_TYPE=booster-k1
HAL_BOARD=booster_k1
HAL_SIMULATE=0
BOOSTER_DDS_DOMAIN=0
BOOSTER_NET_IFACE=enx00e04cfbda07
HAL_AUDIO_INPUT_BACKEND=booster
# The K1 mic is quiet: x4 at the source (also the driver default) brings speech
# above HAL's speech threshold (HAL_VAD_THRESHOLD 3500).
HAL_BOOSTER_MIC_GAIN=4.0
HAL_CAMERA_INDEX=0
HAL_CAMERA_WIDTH=544
HAL_CAMERA_HEIGHT=306

# --- Local voice pipeline: HAL's own realtime orchestrator, all on this machine ---
# Speaker: HAL speech plays on the K1 through Booster's audio service.
HAL_AUDIO_OUTPUT_BACKEND=booster
# K1 speaker volume 0..1 (the robot's player, not this PC's mixer).
HAL_BOOSTER_SPEAKER_VOLUME=0.3
# Brain: the local vLLM (Qwen3.8-27B) via HAL's pipecat_v1 provider, with `look`.
HAL_REALTIME_ENABLED=true
HAL_REALTIME_PROVIDER=pipecat_v1
HAL_PIPECAT_BASE_URL=http://127.0.0.1:8011/v1
HAL_PIPECAT_API_KEY=local
HAL_PIPECAT_MODEL=llm
HAL_PIPECAT_DISABLE_THINKING=true
HAL_PIPECAT_VISION=true
# STT and TTS come from config.json (stt_base_url / tts_base_url) -> speech_servers.py :8096.
# Compact K1 prompt (~2 k chars vs ~28 k built-in) so the local model's context
# fits on one GPU next to STT/TTS. No main agent behind os-server here, so no
# delegate_to_main (every delegation would fail on a dev PC).
HAL_REALTIME_PROMPT_FILE=robots/booster-k1/realtime_prompt.md
HAL_REALTIME_DELEGATE=false
# A cloud cost guard rebuilds the session every 12 turns, which wipes the tool-call
# history a small local model leans on (it then describes actions instead of
# calling tools). A local model costs nothing per turn: keep one session.
HAL_REALTIME_SESSION_MAX_TURNS=0
# HAL's short-transcript noise guard asks Silero whether a <=3-word turn was real
# speech. On the K1's quiet, gain-boosted mic it scores real commands as noise
# ("Step forward." -> voiced_ratio 0.000) and drops them. The compact prompt already
# tells the model to stay silent on noise, so skip the acoustic re-check here.
HAL_REALTIME_REQUIRE_SPEECH_ON_EMPTY_STT=false
# Temperature 0 measured more reliable tool calls (21/30 vs 18/30 at 0.7) at no latency cost.
HAL_PIPECAT_TEMPERATURE=0
