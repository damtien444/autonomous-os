<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS profile for a dev machine on the Booster K1 Ethernet link.
     Mirrors Booster's /opt/booster/BoosterRos2/fastdds_profile.xml: UDP only,
     whitelisted interfaces. Pinned to this machine's address on the K1 link
     (192.168.10.10) plus loopback, so discovery multicast never leaves on the
     building network through the default route.
     Requires 192.168.10.102 in the K1's own profiles' interfaceWhiteList
     (see robots/booster-k1/docs/runtime.md). Do not set this file for the
     Booster SDK; pass the interface name to ChannelFactory.Init instead. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>k1_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>192.168.10.10</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="k1_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>k1_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
