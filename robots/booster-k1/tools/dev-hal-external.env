# Overrides for dev-hal.env when the external voice agent (realtime-voice-agent +
# k1_voice_bridge.py) does the talking. Loaded by run_hal_external.sh.
# HAL then only drives the body and the camera: no own voice loop, and it leaves
# the K1 mic and speaker to the bridge. The robot allows one capture session, so a
# HAL holding the mic makes the bridge fail with "API call failed, code = 5001".
HAL_REALTIME_ENABLED=false
HAL_AUDIO_INPUT_BACKEND=
HAL_AUDIO_OUTPUT_BACKEND=
